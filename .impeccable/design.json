  "narrative": {
    "northStar": "Phone-first music-video editor",
    "overview": "Dhun uses a familiar, compact dark-plum editor around a prominent video preview. Warm text, coral actions and amber selection cues help people make a video in English or Nepali. Numbered cards keep the song-and-photo workflow understandable on a phone.\n\nThis is the established system with an expanded look library. The canvas supplies the expressive range: the original 50 looks remain, joined by 30 distinct minimal, vintage, Nepali-inspired, cinematic, calm and playful compositions. The surrounding controls stay visually consistent as the user's photo and chosen composition change.",
    "keyCharacteristics": [
      "A centered single column with a sticky preview and numbered editing cards.",
      "Dark-plum surfaces, warm text, coral actions and amber state cues.",
      "Bilingual labels and editable canvas titles with Devanagari fallback.",
      "Photo-led canvas compositions with restrained audio response and separate browsing controls."
    ],
    "rules": [
      {
        "name": "The Canvas Palette Rule",
        "body": "Keep the editor palette stable while allowing each composition to use its own materials and the user's photo-derived or chosen accents.",
        "section": "colors"
      },
      {
        "name": "The Editable Title Rule",
        "body": "Reserve a clear title area in each shape and provide text defaults through the shared text renderer. Do not paint fixed song names or lyrics into a look. Titles shrink to their allocated maximum width; explicit newlines remain supported. The shared new-look defaults use plain text, title size relative to the shorter canvas side, and a smaller second line at reduced opacity. User-edited text properties survive look changes.",
        "section": "typography"
      },
      {
        "name": "The Three Shapes Rule",
        "body": "A look is one composition adapted to all three output shapes. Verify the photo, editable title, second line and audio detail together in each shape; cropping a wide layout is not sufficient.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** preserve the familiar single-column editor, sticky preview and numbered workflow.",
      "**Do** retain original template IDs and saved choices when extending the library.",
      "**Do** support English and Nepali labels, Devanagari title fallback and readable editable text in every shape.",
      "**Do** use the user's photo and frame-relative geometry; keep thumbnails faithful to the video composition.",
      "**Do** preserve visible selection, keyboard focus, independent favourite buttons and progressive browsing.",
      "**Do** keep canvas audio response restrained, with ornaments and meters inside their reserved areas."
    ],
    "donts": [
      "**Don't** turn a family-specific canvas palette, typeface or ornament into an editor-wide rule.",
      "**Don't** create another template ID for a recolour or bake fixed song text into artwork.",
      "**Don't** add network-loaded template assets, runtime package dependencies, per-frame pixel processing or canvas filters.",
      "**Don't** introduce full-screen strobing or assume a wide layout works unchanged in tall and square outputs.",
      "**Don't** export editing guides or remove the user's text adjustments when switching looks."
    ]
  }
}
